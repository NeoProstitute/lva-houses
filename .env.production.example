# Copy to .env.production on the production server. Never commit the real file.
NODE_ENV=production
APP_DOMAIN=houses.example.edu
API_PORT=4000
WEB_ORIGIN=https://houses.example.edu
# Leave empty: the browser calls the API through the same HTTPS origin.
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://api:4000
POSTGRES_PASSWORD=replace-with-a-password-manager-generated-value
DATABASE_URL=postgres://school_app:replace-with-a-password-manager-generated-value@postgres:5432/leonardo_v_academy_houses
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-a-48-character-or-longer-secret
BOOTSTRAP_TOKEN=replace-with-a-separate-48-character-or-longer-secret
SCHOOL_SLUG=leonardo-v-academy-houses
COOKIE_SECURE=true
TRUST_PROXY=true
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
