# Copy this file to .env. Generate the secrets with a password manager or:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgres://school_app:change-me@localhost:5432/leonardo_v_academy_houses
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-48-character-or-longer-secret
BOOTSTRAP_TOKEN=replace-with-a-separate-48-character-or-longer-secret
SCHOOL_SLUG=leonardo-v-academy-houses
COOKIE_SECURE=false
TRUST_PROXY=false
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
